<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <SpaRoot>$(MSBuildProjectDirectory)\..\..\frontend\</SpaRoot>
    <BuildFrontend Condition="'$(BuildFrontend)' == ''">true</BuildFrontend>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Afraz.Application\Afraz.Application.csproj" />
    <ProjectReference Include="..\Afraz.Infrastructure\Afraz.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Infra.Common.Decorators" Version="2.0.35" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>
  <Target
    Name="BuildFrontend"
    BeforeTargets="PrepareForBuild"
    Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true' and '$(BuildFrontend)' == 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>
  <Target
    Name="BuildFrontendForLocalRun"
    BeforeTargets="PrepareForBuild"
    Condition="'$(_IsPublishing)' != 'true' and '$(Configuration)' != 'Release' and '$(DesignTimeBuild)' != 'true' and '$(BuildFrontend)' == 'true'">
    <Exec
      WorkingDirectory="$(SpaRoot)"
      Command="npm install --no-audit --no-fund"
      Condition="!Exists('$(SpaRoot)node_modules\.bin\vue-tsc.cmd')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    <ItemGroup>
      <LocalFrontendDistFiles Include="$(SpaRoot)dist\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(LocalFrontendDistFiles)"
      DestinationFiles="@(LocalFrontendDistFiles->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
  <Target
    Name="PublishFrontend"
    AfterTargets="ComputeFilesToPublish"
    Condition="'$(Configuration)' == 'Release' and '$(BuildFrontend)' == 'true'">
    <ItemGroup>
      <FrontendDistFiles Include="$(SpaRoot)dist\**\*" />
      <ResolvedFileToPublish Include="@(FrontendDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
